---
import { Card as ShadcnCard, CardHeader, CardTitle, CardContent } from "@/components/ui/card";

interface Props {
title: string;
body: string;
href: string;
}

const { href, title, body } = Astro.props;
---

<li class="list-none flex">
  <a href={href} class="w-full focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-xl group no-underline">
    <ShadcnCard class="h-full transition-colors group-hover:border-primary group-hover:bg-muted/50">
      <CardHeader>
        <CardTitle class="flex items-center gap-2 text-xl transition-colors group-hover:text-primary">
          {title}
          <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </CardTitle>
      </CardHeader>
      <CardContent>
        <p class="text-muted-foreground m-0">{body}</p>
      </CardContent>
    </ShadcnCard>
  </a>
</li>
