---
import { Icon } from "astro-icon/components";
import { buttonVariants } from "@/components/ui/button";

const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Dashboard", defaultIcon: "inbox", activeIcon: "inbox-filled" },
  { href: "/mails", label: "Mails", defaultIcon: "mail", activeIcon: "mail-filled" },
  { href: "/newsletters", label: "Newsletters", defaultIcon: "news", activeIcon: "news-filled" },
  { href: "/junk", label: "Junk", defaultIcon: "chat_warning", activeIcon: "chat_warning-filled" },
  { href: "/settings", label: "Settings", defaultIcon: "settings", activeIcon: "settings-filled" },
];
---

<header class="flex h-screen w-40 flex-col border-r-2 border-border bg-background font-sans">
  <div class="border-b-2 border-border p-3 text-center">
    <Icon name="logo" class="mx-auto text-5xl text-primary" />
  </div>
  
  {navItems.map(item => {
    const isActive = currentPath === item.href;
    return (
      <a 
        href={item.href} 
        class={`group flex items-center p-3 text-base text-foreground no-underline hover:bg-muted ${isActive ? 'border-l-2 border-primary' : 'border-l-2 border-transparent'}`}
      >
        <span class={`mr-2 text-2xl ${isActive ? 'text-primary' : 'text-foreground group-hover:text-primary'}`}>
          <Icon name={isActive ? item.activeIcon : item.defaultIcon} />
        </span>
        {item.label}
      </a>
    )
  })}

  <a 
    href="/logout"
    class={`${buttonVariants({ variant: "default" })} mt-auto mx-2 mb-2 flex h-10 items-center justify-center text-base`}
  >
    <Icon name="logout-filled" class="mr-2 text-2xl" /> Logout
  </a>

  <div class="p-2 text-center text-xs">
    <a href="https://logo.dev" title="Logo API" class="text-muted-foreground no-underline hover:underline">
      Logos provided by Logo.dev
    </a>
  </div>
</header>
