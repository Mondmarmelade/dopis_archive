# Dopis Configuration Example
# Copy this file to .env and configure your secrets.

# Mandatory 32+ character encryption secret for sessions and auth tokens:
# Generate with: openssl rand -base64 32
SECRET_KEY=replace_with_a_secure_random_32_character_secret_key

# Optional Default IMAP Credentials (for development only):
SECRET_USER=user@example.com
SECRET_PASS=your_password_here

# AI Service Configuration:
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2

# Public Tokens:
PUBLIC_LOGO_DEV_TOKEN=pk_replace_with_your_logo_dev_token

# PocketBase Backend Configuration:
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@dopis.local
POCKETBASE_ADMIN_PASSWORD=dopis_admin_secret_1234
