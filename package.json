{
  "name": "dopis-monorepo",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:reset": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1 -Reset",
    "dev:web": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:only-web": "pnpm --filter @dopis/web dev",
    "dev:mobile": "pnpm --filter @dopis/mobile dev",
    "db:reset": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1 -Reset",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @dopis/web build",
    "build:mobile": "pnpm --filter @dopis/mobile build",
    "pb:docker": "docker compose up -d pocketbase",
    "pb:start": "powershell -ExecutionPolicy Bypass -File scripts/run-pocketbase.ps1",
    "pb:stop": "docker compose down"
  }
}
